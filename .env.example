# Copy this file to .env and fill in the values below, then run ./run.sh

# Required — MongoDB Atlas (or any Mongo) connection string.
MONGODB_URI=

# Optional — powers AI try-on generation and the Style Companion's "Mentor Tip"
# feature. Get a free key at https://openrouter.ai/keys. Leave blank to skip.
OPENROUTER_API_KEY=

# Optional — separate key for just the Mentor Tip feature, so it can be
# rate-limited/rotated independently of the try-on generation key above.
# Falls back to OPENROUTER_API_KEY if left blank.
MENTOR_TIP_OPENROUTER_API_KEY=
