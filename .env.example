# Copy this file to .env and fill in the values below, then run ./run.sh

# Required — MongoDB Atlas (or any Mongo) connection string.
MONGODB_URI=

# Optional — powers the AI Style Companion's "Mentor Tip" feature.
# Get a free key at https://openrouter.ai/keys. Leave blank to skip that feature.
OPENROUTER_API_KEY=

# Virtual Try-On uses Gemini image models via OPENROUTER_API_KEY by default
# (paid — add credits at https://openrouter.ai/credits, ~$0.04/image).
# Optional quality upgrade: a FASHN key (https://app.fashn.ai, ~$0.075/image)
# switches try-on to their purpose-built model. TRYON_ENGINE=fashn|gemini
# overrides the automatic choice. Cached results in the repo work with no key.
FASHN_API_KEY=
